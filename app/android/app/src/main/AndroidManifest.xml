<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deliberately NO android.permission.INTERNET: the app cannot send anything anywhere. -->

    <!-- The permission list IS the privacy claim, so it stays as short as the product allows.
         Everything below marked "spike" exists only to answer I-60 and comes out with the probe,
         before anything is submitted to Play. -->

    <!-- spike (I-60): read per-app byte totals. A special permission the user grants in Settings;
         it reveals byte counts, never content. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- spike (I-60): the probe must keep counting while the person is inside ChatGPT, i.e. while
         Sipcount is backgrounded and would otherwise be frozen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- One <queries> element only: a second one in the same manifest is a merge error.
         Android 11+ hides other packages unless declared; we ask these three for their UID and
         nothing else. -->
    <queries>
        <package android:name="com.openai.chatgpt" />
        <package android:name="com.anthropic.claude" />
        <package android:name="com.google.android.apps.bard" />
        <!-- Gemini lives inside the Google app on most phones; the accessibility config has said
             so since September and the probe was written without checking it. -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

<application
        android:label="Sipcount"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Prompt listener. Sees Send taps in the whitelisted apps, counts characters, drops text. -->
        <service
            android:name=".listener.PromptAccessibilityService"
            android:label="@string/a11y_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- spike (I-60). Comes out with the probe. -->
        <service
            android:name=".probe.ProbeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
